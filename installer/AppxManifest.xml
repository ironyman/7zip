<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest template for the Microsoft Store package. scripts\create-installer.ps1 -Store
     fills the @TOKENS@; for a Store submission IdentityName, Publisher and
     PublisherDisplayName must match Partner Center (Product identity page).
     - SevenZipFM: 7zFM.exe with archive file type associations
       and 7z.exe exposed as the "7z" console execution alias
     - Explorer context menu: 7-zip.dll as a packaged COM server (dllhost surrogate).
       Its class implements IExplorerCommand, so it appears in the Windows 11 menu.
     7zG.exe is in the package for the dialogs that the context menu starts. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop desktop4 desktop5 com rescap">

  <Identity Name="@IDENTITY_NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="@ARCH@" />

  <Properties>
    <DisplayName>@DISPLAY_NAME@</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>7-Zip file archiver with a themed (Light, Dark, Fluent) File Manager.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="SevenZipFM" Executable="7zFM.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="7-Zip File Manager" Description="7-Zip File Manager"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="sevenzip.archive">
            <uap:DisplayName>7-Zip archive</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.7z</uap:FileType>
              <uap:FileType>.zip</uap:FileType>
              <uap:FileType>.rar</uap:FileType>
              <uap:FileType>.tar</uap:FileType>
              <uap:FileType>.gz</uap:FileType>
              <uap:FileType>.tgz</uap:FileType>
              <uap:FileType>.bz2</uap:FileType>
              <uap:FileType>.tbz2</uap:FileType>
              <uap:FileType>.xz</uap:FileType>
              <uap:FileType>.txz</uap:FileType>
              <uap:FileType>.lzma</uap:FileType>
              <uap:FileType>.cab</uap:FileType>
              <uap:FileType>.iso</uap:FileType>
              <uap:FileType>.wim</uap:FileType>
              <uap:FileType>.arj</uap:FileType>
              <uap:FileType>.cpio</uap:FileType>
              <uap:FileType>.rpm</uap:FileType>
              <uap:FileType>.deb</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="7-Zip Shell Extension">
              <com:Class Id="23170F69-40C1-278A-1000-000100020000" Path="7-zip.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="SevenZip" Clsid="23170F69-40C1-278A-1000-000100020000" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="SevenZip" Clsid="23170F69-40C1-278A-1000-000100020000" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <!-- 7z.exe console alias. It hangs off the File Manager app because a separate
             Application with AppListEntry="none" is a "headless app", which the Store
             rejects without the HeadlessAppBypass waiver. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="7z.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="7z.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
